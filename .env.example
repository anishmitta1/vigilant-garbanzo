HOST=0.0.0.0
PORT=3000
# Local SQLite file. For Turso: DATABASE_URL=libsql://<db>-<org>.turso.io and set TURSO_AUTH_TOKEN.
DATABASE_URL=file:mimir.db
TURSO_AUTH_TOKEN=
# SEC EDGAR requires a descriptive User-Agent with contact info.
USER_AGENT=Mimir/0.1 (you@example.com)
POLL_INTERVAL_SECONDS=900
# iPhone push via Bark (https://bark.day.app): install the app and paste the device URL it shows.
BARK_URL=
# Phone push via ntfy (https://ntfy.sh): install the app, subscribe to a long random topic, set it here.
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=
ALERT_WEBHOOK_URL=
# Slack incoming webhook URL (https://api.slack.com/messaging/webhooks).
SLACK_WEBHOOK_URL=
ALERT_THRESHOLD=0.6
WEAK_SIGNAL_FLOOR=0.2
ACCUMULATION_THRESHOLD=1.2
ACCUMULATION_WINDOW_HOURS=72
# Items published longer ago than this are stored and scored but never alert (avoids backlog alerts on first poll).
MAX_ALERT_AGE_HOURS=48
# After an alert on a target (trade/theme/entity), hold further alerts on it for this long unless a direct alert scores >= COOLDOWN_BYPASS_SCORE.
ALERT_COOLDOWN_HOURS=6
COOLDOWN_BYPASS_SCORE=0.9
# Skip alerts for a story (similar headline, any outlet) already alerted on within this window.
STORY_WINDOW_HOURS=48
# Bark only receives direct alerts at or above this score; everything else is stored (and sent to webhooks).
BARK_MIN_SCORE=0.8
# With an LLM: alert (and Bark) iff the model says material=true and consequence >= this.
MATERIAL_MIN_SCORE=0.5
# With LLM_API_KEY set, Bark also needs the model's material=true verdict. Failed calls fall back to the heuristic (never pushes to Bark). Cap spend on the provider side (e.g. an OpenRouter key limit).
SEED_DEFAULTS=true
# Daily Bark digest (alerts, near-misses, pipeline health) at this local time; empty or "off" disables it.
DIGEST_TIME=16:00
DIGEST_TZ=America/Los_Angeles
# Optional System-1 LLM scorer (any OpenAI-compatible chat completions API).
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
# OpenRouter reasoning: off | low | high (unset = model default). Caps output (incl. reasoning) tokens per call.
LLM_REASONING=off
LLM_MAX_TOKENS=1500
