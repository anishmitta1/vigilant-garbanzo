HOST=0.0.0.0
PORT=3000
# Local SQLite file. For Turso: DATABASE_URL=libsql://<db>-<org>.turso.io and set TURSO_AUTH_TOKEN.
DATABASE_URL=file:mimir.db
TURSO_AUTH_TOKEN=
# SEC EDGAR requires a descriptive User-Agent with contact info.
USER_AGENT=Mimir/0.1 (you@example.com)
POLL_INTERVAL_SECONDS=900
# iPhone push via Bark (https://bark.day.app): install the app and paste the device URL it shows.
BARK_URL=
# Phone push via ntfy (https://ntfy.sh): install the app, subscribe to a long random topic, set it here.
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=
ALERT_WEBHOOK_URL=
# Slack incoming webhook URL (https://api.slack.com/messaging/webhooks).
SLACK_WEBHOOK_URL=
ALERT_THRESHOLD=0.6
WEAK_SIGNAL_FLOOR=0.2
ACCUMULATION_THRESHOLD=1.2
ACCUMULATION_WINDOW_HOURS=72
# Items published longer ago than this are stored and scored but never alert (avoids backlog alerts on first poll).
MAX_ALERT_AGE_HOURS=48
# After an alert on a target (trade/theme/entity), hold further alerts on it for this long unless a direct alert scores >= COOLDOWN_BYPASS_SCORE.
ALERT_COOLDOWN_HOURS=6
COOLDOWN_BYPASS_SCORE=0.9
SEED_DEFAULTS=true
# Optional System-1 LLM scorer (any OpenAI-compatible chat completions API).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
